<Window x:Class="ReadyOrNotModManager.App.ErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="错误" Height="560" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#111512" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B211D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#344037"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6ECE4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B2A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D7C35C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2B342D"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#171C18"/>
            <Setter Property="AlternatingRowBackground" Value="#1D241F"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F3932"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="错误" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="下载或部署失败的项目会列在这里，队列其余部分仍会继续执行。" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <DataGrid x:Name="ErrorsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc, StringFormat={}{0:g}}" Width="150"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="110"/>
                <DataGridTextColumn Header="模组" Binding="{Binding ModName}" Width="220"/>
                <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="2*"/>
                <DataGridTextColumn Header="压缩包" Binding="{Binding ArchivePath}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <WrapPanel DockPanel.Dock="Left">
                <Button Content="打开 Nexus 页面" Click="OpenNexus_Click"/>
                <Button Content="打开游戏目录" Click="OpenGameFolder_Click"/>
                <Button Content="打开压缩包目录" Click="OpenArchiveFolder_Click"/>
                <Button Content="复制手动修复说明" Click="CopyManualFix_Click"/>
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="清除错误" Click="ClearErrors_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
