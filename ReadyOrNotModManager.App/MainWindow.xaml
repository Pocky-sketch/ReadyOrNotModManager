<Window x:Class="ReadyOrNotModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:services="clr-namespace:ReadyOrNotModManager.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:syswin="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="----==[ Ready Or Not Mod Manager : By InconspicuousJawa ]==----" Height="820" Width="1320" MinHeight="720" MinWidth="1080"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        MaxHeight="{x:Static syswin:SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static syswin:SystemParameters.MaximizedPrimaryScreenWidth}"
        Background="Transparent" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E1113" Offset="0"/>
            <GradientStop Color="#161D21" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#14191D" Offset="0"/>
            <GradientStop Color="#1F282E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B2226" Offset="0"/>
            <GradientStop Color="#29343A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelAltBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#222B30" Offset="0"/>
            <GradientStop Color="#303C42" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LineBrush" Color="#334149"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8ECEB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A3AFB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C7A957"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#6FA8C9"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#D77766"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#7EB386"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D6A84F"/>
        <SolidColorBrush x:Key="InactiveBrush" Color="#6F7A82"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#43515A" Opacity="0.68"/>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D91B252B" Offset="0"/>
            <GradientStop Color="#A8141B21" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardAltBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0222D34" Offset="0"/>
            <GradientStop Color="#AA141A20" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="GlowBlueBrush" Center="0.18,0.08" GradientOrigin="0.18,0.08" RadiusX="0.78" RadiusY="0.62">
            <GradientStop Color="#304E86B8" Offset="0"/>
            <GradientStop Color="#0010161A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowAmberBrush" Center="0.9,0.2" GradientOrigin="0.9,0.2" RadiusX="0.64" RadiusY="0.54">
            <GradientStop Color="#22C7A957" Offset="0"/>
            <GradientStop Color="#0010161A" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="VignetteBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.78">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#B8000000" Offset="1"/>
        </RadialGradientBrush>
        <services:QueueStatusLabelConverter x:Key="QueueStatusLabelConverter"/>
        <services:QueueStatusIconConverter x:Key="QueueStatusIconConverter"/>
        <services:QueueStatusBrushConverter x:Key="QueueStatusBrushConverter"/>
        <services:VisualToneBrushConverter x:Key="VisualToneBrushConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="{DynamicResource MutedBrush}" Opacity="0.72" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                                <Setter TargetName="Watermark" Property="Opacity" Value="0.38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#D01E2A32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="Chrome" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6FA8C9" BlurRadius="13" ShadowDepth="0" Opacity="0.23"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource InactiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B82B4D63"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A9233D4D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="DownloadButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B820344B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style x:Key="DeployButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B8233A2B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B8472722"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style x:Key="SpecialButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B83A3524"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#66172229"/>
            <Setter Property="AlternatingRowBackground" Value="#88202B33"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E0141C22"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#553B5361"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#704D6A78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" CornerRadius="8,0,0,8" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                <ContentPresenter Margin="12,8,10,8" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#5530414B"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="#77344650"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#665D7580"/>
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#D0141C22"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#66344650"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#88415A66"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,6,10,10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#AA0F161C"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource MutedBrush}" Width="8" Height="5" Stretch="Fill" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}" Padding="2">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot" Background="Transparent" Width="18" SnapsToDevicePixels="True">
                            <Border x:Name="ScrollTrackChrome" Background="#44101922" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="2"/>
                            <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" MinHeight="128" MinWidth="14" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BlueBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding BorderBrush}" CornerRadius="9" Margin="1">
                                                    <Border x:Name="ThumbChrome" Background="{TemplateBinding Background}" CornerRadius="8" Margin="1"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource RailBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="ScrollRoot" Property="Width" Value="Auto"/>
                                <Setter TargetName="ScrollRoot" Property="Height" Value="18"/>
                                <Setter TargetName="ScrollTrackChrome" Property="Margin" Value="2"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="14"/>
                                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="128"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailHelpButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#66101922"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HelpChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpChrome" Property="Background" Value="#88304B5B"/>
                                <Setter TargetName="HelpChrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HelpChrome" Property="Background" Value="#AA203846"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#552D3F4A"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#77394B55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="CustomTitleBar" Background="{DynamicResource RailBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="16" Height="16" Margin="0,0,9,0"/>
            </StackPanel>
            <TextBlock Text="-----===::[   Ready Or Not Mod Manager : By InconspicuousJawa   ]::===-----"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                <Button Style="{StaticResource WindowCaptionButton}" Click="MinimizeWindow_Click" ToolTip="最小化">
                    <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource WindowCaptionButton}" Click="MaximizeRestoreWindow_Click" ToolTip="最大化">
                    <iconPacks:PackIconMaterial x:Name="MaximizeRestoreIcon" Kind="WindowMaximize" Width="15" Height="15"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="关闭">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
    <Grid Grid.Row="1" Background="{DynamicResource ShellBrush}">
        <Rectangle Fill="{StaticResource GlowBlueBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource GlowAmberBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>
        <Grid x:Name="SetupRoot" Visibility="Collapsed" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource RailBrush}" Padding="34">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="READY OR NOT" FontSize="14" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="部署工作站设置" FontSize="38" FontWeight="SemiBold" Margin="0,8,0,16"/>
                    <TextBlock Text="Connect Nexus, locate the game, and choose where archives and modpacks live. You only need this screen when setup is missing or reset." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15"/>
                    <Border Margin="0,28,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Height="1"/>
                    <TextBlock Text="状态检查" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
                    <TextBlock x:Name="SetupNexusStatusText" Text="Nexus 连接未测试" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupGameStatusText" Text="游戏目录未验证" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                    <TextBlock x:Name="SetupFoldersStatusText" Text="存储目录未验证" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="28" Margin="18,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="设置向导" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="字段就绪后会变绿；以上内容之后都可以在设置里修改。" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,18"/>

                        <TextBlock Text="Nexus API 密钥" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="SetupApiKeyBox"/>
                        <WrapPanel>
                            <Button Content="获取 API 密钥" Click="OpenApiKeyPage_Click"/>
                            <Button Content="测试连接" Click="TestConnection_Click" Style="{StaticResource PrimaryButton}"/>
                        </WrapPanel>

                        <TextBlock Text="Ready or Not 安装目录" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupGameDirectoryBox"/>
                        <WrapPanel>
                            <Button Content="选择游戏目录" Click="BrowseSetupGameDirectory_Click"/>
                            <Button Content="自动检测游戏目录" Click="AutoDetectGameFolder_Click"/>
                        </WrapPanel>

                        <TextBlock Text="下载目录" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupDownloadDirectoryBox"/>
                        <Button Content="选择下载目录" Click="BrowseSetupDownloadDirectory_Click"/>

                        <TextBlock Text="浏览器手动下载的导入目录" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupImportDirectoryBox"/>
                        <Button Content="选择导入目录" Click="BrowseSetupImportDirectory_Click"/>

                        <TextBlock Text="整合包库目录" FontWeight="SemiBold" Margin="0,14,0,0"/>
                        <TextBox x:Name="SetupProfileLibraryDirectoryBox"/>
                        <Button Content="选择整合包库目录" Click="BrowseSetupProfileLibraryDirectory_Click"/>

                        <DockPanel Margin="0,22,0,0">
                            <TextBlock x:Name="SetupMessageText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="继续" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="ContinueSetup_Click" Style="{StaticResource PrimaryButton}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#D4141B21" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Ready Or Not" FontSize="25" FontWeight="Bold"/>
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.9" Margin="0,9,0,10"/>
                        <TextBlock x:Name="SidebarVersionText" Text="模组套件" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,20" TextWrapping="Wrap"/>
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Click="DashboardNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ViewDashboardOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="仪表盘"/></StackPanel>
                        </Button>
                        <Button x:Name="ModsNavButton" Style="{StaticResource NavButton}" Click="ModsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="已安装"/></StackPanel>
                        </Button>
                        <Button x:Name="QueueNavButton" Style="{StaticResource NavButton}" Click="QueueNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PlaylistCheck" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="模组"/></StackPanel>
                        </Button>
                        <Button x:Name="ModpacksNavButton" Style="{StaticResource NavButton}" Click="ModpacksNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="整合包"/></StackPanel>
                        </Button>
                        <Button x:Name="DownloadsNavButton" Style="{StaticResource NavButton}" Click="DownloadsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Tools" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="工具"/></StackPanel>
                        </Button>
                        <Button x:Name="LogsNavButton" Style="{StaticResource NavButton}" Click="LogsNav_Click">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="日志/错误"/></StackPanel>
                        </Button>
                    </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,16">
                            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNav_Click" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CogOutline" Width="18" Height="18" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel>
                            </Button>
                            <TextBlock Text="连接状态" Style="{StaticResource SectionEyebrow}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial x:Name="RailGameStatusIcon" Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="游戏" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RailGameStatusText" Text="未知" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial x:Name="RailNexusStatusIcon" Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nexus" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="RailNexusStatusText" Text="未知" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource RailHelpButton}" Click="ShowHelp_Click" ToolTip="帮助">
                                <iconPacks:PackIconMaterial Kind="Help" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource RailHelpButton}" Click="ShowSocials_Click" ToolTip="支持与社交" Margin="8,0,0,0">
                                <iconPacks:PackIconMaterial Kind="ShareVariantOutline" Width="19" Height="19"/>
                            </Button>
                        </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel x:Name="PageHeaderPanel">
                        <TextBlock x:Name="PageTitleText" Text="仪表盘" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Ready or Not 模组部署概览" Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="6" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial x:Name="DashboardGameIcon" Kind="GamepadVariantOutline" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="游戏状态" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardGameStatusText" Grid.Row="1" Text="未检测到" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                        <TextBlock x:Name="DashboardGameHelperText" Grid.Row="2" Text="请选择或自动检测游戏目录" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial x:Name="DashboardNexusIcon" Kind="AccountQuestionOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="NEXUS" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,10,0,2">
                                            <TextBlock x:Name="DashboardNexusPrefixText" Text="已连接：" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"/>
                                            <TextBlock x:Name="DashboardNexusStatusText" Text="未测试" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardNexusHelperText" Grid.Row="2" Text="在设置中运行连接测试" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="已安装" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="InstalledModCountText" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="已记录部署的模组" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="PlaylistCheck" Width="18" Height="18" Foreground="{DynamicResource BlueBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="待处理" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PendingQueueCountText" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="等待处理的队列项" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="FolderMultipleOutline" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="整合包" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ModpackCountText" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="已保存的本地配置档" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" ToolTip="从 GitHub 检查最新版本" MouseLeftButtonUp="RefreshUpdateStatus_Click">
                                            <iconPacks:PackIconMaterial x:Name="DashboardUpdateIcon" Kind="Update" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="应用版本" Style="{StaticResource SectionEyebrow}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardUpdateStatusText" Grid.Row="1" Text="当前：检查中" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,2"/>
                                        <TextBlock x:Name="DashboardUpdateHelperText" Grid.Row="2" Text="正在检查 GitHub 最新版本" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="快捷操作" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="粘贴 Nexus 模组或合集链接，即可在仪表盘内完成入队、导入或部署。" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>
                                    <TextBox x:Name="UrlBox" Tag="input Nexus URL here..." ToolTip="粘贴 Ready or Not 模组或合集的链接"/>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Nexus Mods" Click="OpenReadyOrNotModsPage_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="Nexus 合集" Click="OpenReadyOrNotCollectionsPage_Click" Style="{StaticResource SpecialButton}"/>
                                            <Button Content="启动游戏" Click="RunGame_Click" Style="{StaticResource DeployButton}"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button Content="添加 Nexus 链接" Click="AddUrl_Click" Tag="{Binding ElementName=UrlBox}" Style="{StaticResource ActionButton}"/>
                                            <Button Content="导入压缩包" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="部署全部已下载" Click="DeployDownloaded_Click" Style="{StaticResource DeployButton}"/>
                                            <Button Content="显示本地整合包" Click="ShowLocalModpacks_Click" Style="{StaticResource SpecialButton}"/>
                                            <Button Content="打开模组目录" Click="OpenModsFolder_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="打开游戏目录" Click="OpenGameFolder_Click" Style="{StaticResource ActionButton}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="最近活动" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="RecentActivityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#66141C22" BorderBrush="#3343515A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="18" Height="18" Foreground="{Binding Tone, Converter={StaticResource VisualToneBrushConverter}}" Margin="0,1,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ModsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="InstalledModsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="模组" Binding="{Binding ModName}" Width="2*"/>
                                    <DataGridTextColumn Header="压缩包" Binding="{Binding ArchivePath}" Width="2*"/>
                                    <DataGridTextColumn Header="已安装" Binding="{Binding InstalledAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                    <DataGridTextColumn Header="文件" Binding="{Binding DeployedFiles.Count}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                            <Button Content="卸载所选" Click="UninstallInstalledSelected_Click" Style="{StaticResource DangerButton}"/>
                            <Button Content="打开模组目录" Click="OpenModsFolder_Click" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                    </Grid>

                    <Grid x:Name="QueuePage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QueueUrlBox" Tag="input Nexus URL here..." Margin="0,0,10,0" ToolTip="粘贴 Ready or Not 模组或合集的链接"/>
                                <Button Grid.Column="1" Content="添加" Click="AddUrl_Click" Tag="{Binding ElementName=QueueUrlBox}" Style="{StaticResource PrimaryButton}" Margin="0,0,18,0"/>
                                <TextBox x:Name="QueueSearchBox" Grid.Column="2" Tag="search mods" Margin="0,0,10,0" ToolTip="搜索队列中的模组" TextChanged="QueueFilter_Changed"/>
                                <ComboBox x:Name="QueueStatusFilterBox" Grid.Column="3" Margin="0,0,10,0" SelectionChanged="QueueFilter_Changed"/>
                                <TextBlock x:Name="QueueSummaryText" Grid.Column="4" Text="0 项" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="模组" Binding="{Binding ModName}" Width="2*"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="110"/>
                                    <DataGridTextColumn Header="模组 ID" Binding="{Binding ModId}" Width="80"/>
                                    <DataGridTextColumn Header="文件 ID" Binding="{Binding FileId}" Width="80"/>
                                    <DataGridTextColumn Header="压缩包" Binding="{Binding ArchivePath}" Width="2*"/>
                                    <DataGridTemplateColumn Header="状态" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{Binding Status, Converter={StaticResource QueueStatusBrushConverter}}" Padding="8,3" HorizontalAlignment="Left" Background="#33141C22">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="{Binding Status, Converter={StaticResource QueueStatusIconConverter}}" Width="13" Height="13" Foreground="{Binding Status, Converter={StaticResource QueueStatusBrushConverter}}" Margin="0,1,5,0"/>
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource QueueStatusLabelConverter}}" Style="{StaticResource BadgeText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,12,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="下载缺失项" Click="DownloadMissing_Click" Style="{StaticResource DownloadButton}"/>
                                    <Button Content="部署所选" Click="DeploySelected_Click" Style="{StaticResource DeployButton}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0">
                                    <Button Content="打开 Nexus 页面" Click="OpenSelectedPage_Click" Style="{StaticResource SpecialButton}"/>
                                    <Button Content="导入压缩包" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="删除下载" Click="DeleteDownloadedArchive_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="卸载所选" Click="UninstallSelected_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="移除所选" Click="RemoveSelectedQueueItems_Click" Style="{StaticResource DangerButton}"/>
                                    <Button Content="清除已完成" Click="ClearCompleted_Click" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ModpacksPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2" PreviewMouseRightButtonDown="ProfilesGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="重命名整合包" Click="RenameProfile_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="模组" Binding="{Binding Items.Count}" Width="80"/>
                                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" Width="180"/>
                                    <DataGridTextColumn Header="配置档 ID" Binding="{Binding ProfileId}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBox x:Name="ProfileNameBox" Width="260" DockPanel.Dock="Left" Tag="Input Profile Name" ToolTip="配置档名称"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="当前配置另存为新档" Click="SaveProfileNew_Click" Style="{StaticResource SpecialButton}"/>
                                <Button Content="更新所选" Click="UpdateProfileSelected_Click" Style="{StaticResource SpecialButton}"/>
                                <Button Content="加载所选" Click="LoadProfileSelected_Click" Style="{StaticResource ActionButton}"/>
                                <Button Content="激活所选" Click="ActivateProfileSelected_Click" Style="{StaticResource DeployButton}"/>
                                <Button Content="删除所选" Click="DeleteProfileSelected_Click" Style="{StaticResource DangerButton}"/>
                            </WrapPanel>
                        </DockPanel>
                    </Grid>

                    <ScrollViewer x:Name="DownloadsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="ShareVariantOutline" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="导入 / 导出整合包" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Share Nexus mod links without sending downloaded archives. Imported modpacks are saved locally and loaded into Mods." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="SharedModpackSelector" Margin="0,0,0,4" ToolTip="选择要导出的本地整合包">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="SharedModpackExportStateText" Text="请选择要导出的本地整合包。" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button x:Name="ExportSharedModpackButton" Content="导出整合包" Click="ExportSharedModpack_Click" Style="{StaticResource SpecialButton}"/>
                                            <Button Content="导入整合包" Click="ImportSharedModpack_Click" Style="{StaticResource ActionButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="ArchiveOutline" Width="18" Height="18" Foreground="{DynamicResource BlueBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="压缩包位置" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="打开已保留的下载、导入手动下载的压缩包，或补下队列中缺失的文件。" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button Content="打开下载目录" Click="OpenDownloadDirectory_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="导入压缩包" Click="ImportArchive_Click" Style="{StaticResource ActionButton}"/>
                                            <Button Content="下载队列中缺失的项" Click="DownloadMissing_Click" Style="{StaticResource DownloadButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="清理" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="Remove selected downloaded archive files from disk without uninstalling deployed mod files." Foreground="{DynamicResource MutedBrush}" Margin="0,6,24,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="删除所选下载" Click="DeleteDownloadedArchive_Click" Style="{StaticResource DangerButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="计划中的工具" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="面向大型模组组合的修复与安全工具（开发中）。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,14"/>
                                    <UniformGrid Columns="3">
                                        <Border Background="#55141C22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0" Opacity="0.72" IsHitTestVisible="False">
                                            <StackPanel>
                                                <DockPanel>
                                                    <iconPacks:PackIconMaterial Kind="Radar" Width="22" Height="22" Foreground="{DynamicResource InactiveBrush}"/>
                                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                                        <TextBlock Text="即将推出" FontSize="11" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="模组冲突扫描" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                                <TextBlock Text="扫描已安装与队列中的模组，查找可能的文件冲突。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#55141C22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="5,0" Opacity="0.72" IsHitTestVisible="False">
                                            <StackPanel>
                                                <DockPanel>
                                                    <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="22" Height="22" Foreground="{DynamicResource InactiveBrush}"/>
                                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                                        <TextBlock Text="即将推出" FontSize="11" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="备份已部署模组" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                                <TextBlock Text="为当前已部署的模组组合创建备份。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#55141C22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="10,0,0,0" Opacity="0.72" IsHitTestVisible="False">
                                            <StackPanel>
                                                <DockPanel>
                                                    <iconPacks:PackIconMaterial Kind="Restore" Width="22" Height="22" Foreground="{DynamicResource InactiveBrush}"/>
                                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                                                        <TextBlock Text="即将推出" FontSize="11" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="恢复上一次部署" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                                <TextBlock Text="恢复到上一次可用的部署备份。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                    <TextBlock Text="NEXUS 连接" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nexus API 密钥" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <PasswordBox x:Name="ApiKeyBox"/>
                                    <CheckBox x:Name="AutoTestNexusOnLaunchBox" Content="启动时自动测试 Nexus 连接" HorizontalAlignment="Center"/>
                                    <WrapPanel HorizontalAlignment="Center"><Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource SpecialButton}"/><Button Content="获取 API 密钥" Click="OpenApiKeyPage_Click" Style="{StaticResource ActionButton}"/><Button Content="测试连接" Click="TestConnection_Click" Style="{StaticResource DownloadButton}"/></WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                    <TextBlock Text="游戏目录" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ready or Not 安装目录" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="GameDirectoryBox"/>
                                    <WrapPanel HorizontalAlignment="Center"><Button Content="选择游戏目录" Click="BrowseGameDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="自动检测游戏目录" Click="AutoDetectGameFolder_Click" Style="{StaticResource DownloadButton}"/><Button Content="打开游戏目录" Click="OpenGameFolder_Click" Style="{StaticResource ActionButton}"/></WrapPanel>

                                    <TextBlock Text="下载目录" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="DownloadDirectoryBox"/>
                                    <WrapPanel HorizontalAlignment="Center"><Button Content="选择下载目录" Click="BrowseDownloadDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="打开目录" Click="OpenDownloadDirectory_Click" Style="{StaticResource ActionButton}"/></WrapPanel>

                                    <TextBlock Text="浏览器手动下载的导入目录" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="ImportDirectoryBox"/>
                                    <Button Content="选择导入目录" Click="BrowseImportDirectory_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Center"/>

                                    <TextBlock Text="整合包库目录" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="ProfileLibraryDirectoryBox"/>
                                    <WrapPanel HorizontalAlignment="Center"><Button Content="选择整合包库目录" Click="BrowseProfileLibraryDirectory_Click" Style="{StaticResource ActionButton}"/><Button Content="打开库目录" Click="OpenProfileLibraryDirectory_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                    <TextBlock Text="外观" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="配色方案" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                    <ComboBox x:Name="ThemeSelector" DisplayMemberPath="DisplayName" SelectedValuePath="Name" SelectionChanged="ThemeSelection_Changed" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                    <TextBlock Text="高级" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Center"/>
                                    <CheckBox x:Name="AdvancedOptionsBox" Content="高级部署选项" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" BorderBrush="{DynamicResource DangerBrush}">
                                <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                                    <TextBlock Text="危险区" Style="{StaticResource SectionEyebrow}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="重置设置向导，或清除本地设置、队列、清单与日志。" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,8" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button Content="重置设置向导" Click="ResetSetupWizard_Click" Style="{StaticResource SpecialButton}"/>
                                        <Button Content="清除用户数据" Click="ClearUserData_Click" Style="{StaticResource DangerButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <DataGrid x:Name="ErrorsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc, StringFormat={}{0:g}}" Width="150"/>
                                    <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="120"/>
                                    <DataGridTextColumn Header="模组" Binding="{Binding ModName}" Width="220"/>
                                    <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="2*"/>
                                    <DataGridTextColumn Header="压缩包" Binding="{Binding ArchivePath}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="打开 Nexus 页面" Click="OpenErrorNexus_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="打开游戏目录" Click="OpenErrorGameFolder_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="打开压缩包目录" Click="OpenErrorArchiveFolder_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="复制手动修复说明" Click="CopyErrorManualFix_Click" Style="{StaticResource SpecialButton}"/>
                            <Button Content="清除错误" Click="ClearErrors_Click" Style="{StaticResource DangerButton}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <DockPanel LastChildFill="True">
                        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed">
                            <ProgressBar x:Name="OverallProgressBar" Width="420" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,0,16,0"/>
                            <TextBlock x:Name="ProgressText" Text="" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Background="#AA03070C">
            <Border Style="{StaticResource CardBorderStyle}" Width="560" MaxWidth="720" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Ready Or Not Mod Manager 使用指南" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="常规模组使用流程速览。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Click="CloseHelp_Click" Style="{StaticResource RailHelpButton}" Margin="18,0,0,0" ToolTip="关闭帮助" HorizontalAlignment="Right">
                            <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <TextBlock Text="1. 完成设置：填入 Nexus API 密钥并选择 Ready or Not 安装目录。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="2. Use Mods to add Nexus mod or collection URLs, or use Utilities to import archives and shared modpack files." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="3. Download missing queue items, then deploy downloaded mods into ReadyOrNot\\Content\\Paks." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="4. 想在不同模组组合之间切换时，把已部署的模组保存为整合包。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="5. 若某个模组失败，查看「日志/错误」。程序会跳过失败项，让队列其余部分继续执行。" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#44101922" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,22,0,0">
                        <TextBlock Text="Tip: downloads, API keys, logs, and modpack settings are stored locally on this PC. Shared modpack exports contain links only, not archive files." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SocialsOverlay" Visibility="Collapsed" Background="#AA03070C">
            <Border Style="{StaticResource CardBorderStyle}" Width="540" MaxWidth="700" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="支持 / 社交" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="反馈问题、寻求帮助或联系作者。" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Click="CloseSocials_Click" Style="{StaticResource RailHelpButton}" Margin="18,0,0,0" ToolTip="关闭社交链接" HorizontalAlignment="Right">
                            <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,0">
                        <Button Click="OpenGithub_Click" Style="{StaticResource ActionButton}" Padding="14" Margin="0,0,10,0" ToolTip="打开 GitHub">
                            <StackPanel>
                                <iconPacks:PackIconMaterial Kind="CodeBraces" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="GitHub" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="jdharleyjones" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenInstagram_Click" Style="{StaticResource SpecialButton}" Padding="14" Margin="5,0,5,0" ToolTip="打开 Instagram">
                            <StackPanel>
                                <iconPacks:PackIconMaterial Kind="CameraOutline" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Instagram" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="cyb3r.sk4ter" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="CopyDiscord_Click" Style="{StaticResource PrimaryButton}" Padding="14" Margin="10,0,0,0" ToolTip="复制 Discord 用户名">
                            <StackPanel>
                                <iconPacks:PackIconMaterial Kind="ForumOutline" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Discord" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="inconspicuousjawa" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#44101922" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,22,0,0">
                        <TextBlock Text="Discord handles do not have a reliable public profile link, so the Discord card copies the username to your clipboard." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
