<Window x:Class="ReadyOrNotModManager.App.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整合包" Height="560" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#111512" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B211D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#344037"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6ECE4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B2A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D7C35C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,8,8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#101410"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2B342D"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#171C18"/>
            <Setter Property="AlternatingRowBackground" Value="#1D241F"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2F3932"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D7DEE0"/>
            <Setter Property="Foreground" Value="#11181C"/>
            <Setter Property="BorderBrush" Value="#AEB8BA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="整合包" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="把当前队列保存为一套可切换的 Ready or Not 配置。" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <DataGrid x:Name="ProfilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="模组" Binding="{Binding Items.Count}" Width="80"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}" Width="180"/>
                <DataGridTextColumn Header="配置档 ID" Binding="{Binding ProfileId}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Width="300">
                <TextBlock Text="配置档名称" FontWeight="SemiBold"/>
                <TextBox x:Name="ProfileNameBox"/>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="当前配置另存为新档" Click="SaveNew_Click" Background="#3A3F28" BorderBrush="{StaticResource AccentBrush}"/>
                <Button Content="更新所选" Click="UpdateSelected_Click"/>
                <Button Content="加载所选" Click="LoadSelected_Click"/>
                <Button Content="激活所选" Click="ActivateSelected_Click"/>
                <Button Content="删除所选" Click="DeleteSelected_Click"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
